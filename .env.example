# Database (PostgreSQL + pgvector via docker-compose)
DATABASE_URL=postgresql://clinical:clinical@localhost:5432/clinical_saas

# Auth
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Storage: local (dev) or s3 (production)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS (comma-separated origins for your friend's frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
